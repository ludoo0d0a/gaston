{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gaston-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // Free plan: no cron triggers (10 ms CPU — ingest runs in GitHub Actions).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gaston-pois",
      "database_id": "c7cab17b-418e-4f3a-af93-20940801a192",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DUMPS",
      // Create with: npx wrangler r2 bucket create gaston-dumps
      "bucket_name": "gaston-dumps"
    }
  ]
}
