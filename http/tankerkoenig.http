### Tankerkönig API (Germany)
### Real-time fuel prices for gas stations in Germany
### Docs: https://creativecommons.tankerkoenig.de/

@baseUrl = https://creativecommons.tankerkoenig.de/json
@apiKey = {{GERMANY_TANKERKOENIG_KEY}}

### List stations near Berlin
GET {{baseUrl}}/list.php?lat=52.5200&lng=13.4050&rad=10&sort=dist&type=all&apikey={{apiKey}}
Accept: application/json

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Response is OK", function() {
        client.assert(response.body.ok === true, "Tankerkoenig 'ok' field is not true");
        client.assert(Array.isArray(response.body.stations), "Response missing stations array");
        client.assert(response.body.stations.length > 0, "No stations found");
    });
    client.test("Station object structure", function() {
        var station = response.body.stations[0];
        client.assert(station.hasOwnProperty("id"), "Station missing 'id'");
        client.assert(station.hasOwnProperty("name"), "Station missing 'name'");
        client.assert(typeof station.lat === "number", "Station 'lat' is not a number");
        client.assert(typeof station.lng === "number", "Station 'lng' is not a number");
    });
%}

