### Ionity API data https://www.ionity.eu/open-data-request
###
### Compatible Eco-Movement OCPI Data API quick checks
### Docs: https://developers.eco-movement.com/reference/getting-started-data-api

@baseUrl = https://api.eco-movement.com/api/ocpi/cpo/2.2
@token = {{ECO_MOVEMENT_KEY}}

### Versions (sanity check)
GET {{baseUrl}}/versions
Authorization: Token {{token}}
Accept: application/json

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### List locations (page)
GET {{baseUrl}}/locations?limit=10&offset=0
Authorization: Token {{token}}
Accept: application/json

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
    client.test("Response contains data", function() {
        client.assert(response.body.hasOwnProperty("data"), "Response body missing 'data' object");
        client.assert(Array.isArray(response.body.data), "Data is not an array");
        client.assert(response.body.data.length > 0, "No data found");
    });
    client.test("Location object structure", function() {
        var location = response.body.data[0];
        client.assert(location.hasOwnProperty("id"), "Location missing 'id'");
        client.assert(location.hasOwnProperty("name"), "Location missing 'name'");
        client.assert(location.hasOwnProperty("coordinates"), "Location missing 'coordinates'");
    });
%}

### Location by id (replace with an id from the list response)
@locationId = REPLACE_ME
GET {{baseUrl}}/location/{{locationId}}
Authorization: Token {{token}}
Accept: application/json

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

